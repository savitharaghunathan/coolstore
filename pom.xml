<?xml version="1.0" encoding="UTF-8"?>
<project
    xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.quarkus.platform</groupId>
        <artifactId>quarkus-bom</artifactId>
        <version>3.8.1</version>
        <relativePath/>
    </parent>
    <groupId>com.redhat.coolstore</groupId>
    <artifactId>coolstore-quarkus</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>coolstore-quarkus</name>
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.build.timestamp.format>yyyyMMdd'T'HHmmss</maven.build.timestamp.format>
        <project.encoding>UTF-8</project.encoding>
        <!-- Bumped 11 -> 17 by MigIQ execute stage (TG 1.1): Quarkus 3.7+ dropped Java 11
             support; quarkus-maven-plugin 3.8.1 mojos fail to load on JDK 11 (PluginContainerException).
             Pre-authorized by migration-prompt.md constraint: "bump to 17 only if required". -->
        <maven.compiler.release>17</maven.compiler.release>
        <quarkus.platform.artifact-id>quarkus-bom</quarkus.platform.artifact-id>
        <quarkus.platform.group-id>io.quarkus.platform</quarkus.platform.group-id>
        <quarkus.platform.version>3.8.1</quarkus.platform.version>
    </properties>
    <dependencies>
        <!-- Jakarta EE Core (CDI, REST, Persistence, Transactions) -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-resteasy-reactive-jackson</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-hibernate-orm</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-jdbc-postgresql</artifactId>
        </dependency>
        <!-- JAXB Support for XML serialization (InventoryEntity.java uses @XmlRootElement) -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-jaxb</artifactId>
        </dependency>
        <!-- SmallRye Reactive Messaging with Kafka Connector (Amendment 2) -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-reactive-messaging-kafka</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.kafka</groupId>
            <artifactId>kafka-clients</artifactId>
        </dependency>
        <!-- Transaction Support for @Transactional on @Incoming methods (Amendment 1) -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-narayana-jta</artifactId>
        </dependency>
        <!-- Database Migration: Flyway (compatible version for Quarkus) -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-flyway</artifactId>
        </dependency>
        <!-- Logging (SLF4J) -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-logging-json</artifactId>
        </dependency>
        <!-- Keycloak/OIDC Integration [TODO(port): Keycloak realm/client setup required] -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-oidc</artifactId>
        </dependency>
        <!-- Audit Logging Library (TG 5.2): custom com.enterprise jar bootstrapped into the
             local repository via mvn install:install-file (see mig-execute-workspace
             execution-log). Version 2.0.0 chosen per migration inventory recommendation. -->
        <dependency>
            <groupId>com.enterprise</groupId>
            <artifactId>audit-logging-library</artifactId>
            <version>2.0.0</version>
        </dependency>
        <!-- Test Dependencies -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- TG 6.1 fix: quarkus-test-h2 does not register an Agroal JDBC driver, so
             @QuarkusTest bootstrap failed ("Unable to find a JDBC driver ... 'h2'").
             quarkus-jdbc-h2 registers the driver for the base (H2) profile; %prod
             overrides to PostgreSQL at runtime (profile matrix, TG 5.5). -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-jdbc-h2</artifactId>
        </dependency>
        <!-- [TODO(port): Ensure application.properties has %test.quarkus.datasource.db-kind=h2 to activate H2 for tests] -->
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- TG 6.1: mockito-junit-jupiter was missing (CartEndpointTest imports
             org.mockito.junit.jupiter.MockitoExtension) — test-compile failure in baseline -->
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Kafka Testing: in-memory connector for @Incoming/@Outgoing methods -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-test-kafka-companion</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- TG 6.1 fix: %test profile configures smallrye-in-memory connectors, but the
             kafka extension only registers the Kafka connector — the in-memory connector
             artifact is needed for @QuarkusTest bootstrap. -->
        <dependency>
            <groupId>io.smallrye.reactive</groupId>
            <artifactId>smallrye-reactive-messaging-in-memory</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <finalName>coolstore</finalName>
        <plugins>
            <!-- Quarkus Maven Plugin (required for building Quarkus apps) -->
            <plugin>
                <groupId>io.quarkus</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <version>${quarkus.platform.version}</version>
                <extensions>true</extensions>
                <executions>
                    <execution>
                        <goals>
                            <goal>build</goal>
                            <goal>generate-code</goal>
                            <goal>generate-code-tests</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- Java Compiler: Java 11 target for Quarkus 3.x -->
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <encoding>${project.encoding}</encoding>
                    <release>${maven.compiler.release}</release>
                </configuration>
            </plugin>
            <!-- Static front end (TG 4.2): copy AngularJS assets from src/main/webapp
                 into META-INF/resources so Quarkus serves them from the jar at / -->
            <plugin>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>copy-webapp-static-resources</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/META-INF/resources</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>src/main/webapp</directory>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Coverage gate (TG 6.5): JaCoCo line coverage on com.redhat.coolstore.* -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.11</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- Surefire for testing -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.0.0</version>
                <configuration>
                    <systemPropertyVariables>
                        <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <!-- [TODO(port): OpenShift profile with native image build configuration] -->
    </profiles>
</project>
