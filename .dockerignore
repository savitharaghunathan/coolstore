# Keep the image build context minimal — only pom.xml, src/, and lib/ (audit jar)
# are needed by the Dockerfile. Everything else is repo/migration tooling.
.git
.gitignore
.rgctl
.claude
.github
.vscode
.project
README.md
SETUP.md
assets
rules
migration
mig-plan-workspace
mig-execute-workspace
mig-prompt-workspace
realm-export.json
Dockerfile
.dockerignore
podman-compose.yml
*.yaml
CONTAINERIZATION_REPORT.md
*.log
*.md
target/
build/
node_modules/
__pycache__/
*.pyc
.env
